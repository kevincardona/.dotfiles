#!/usr/bin/env bash
# klog — tail a pod's (or deployment's) logs in a dedicated "k8s" tmux SESSION,
# one reusable window per target: JSON-highlighted, each line prefixed with
# [context/namespace/pod]. Read-only. Used by the television k8s channels.
#
#   klog <context> <namespace> <target>     target = <pod> or deployment/<name>
#   klog --group  <group> <target>          one pane per context in the group
#
# All log windows live in a single tmux session named "k8s"; opening a log
# switches you into that session (creating + attaching it if it doesn't exist,
# even when you launched tv from outside tmux). Re-opening the same target jumps
# to the window already tailing it, so your tails stay "in memory" one keypress
# away. Each window views logs in `less -RS +F`: no wrap (←/→ scroll wide lines),
# '/' search, live follow — Ctrl-C pauses follow, Shift-F resumes, q quits (set
# KLOG_LESS=0 for a plain live pane with copy-mode). prefix+p hops back to your
# last window; prefix+L / prefix+( switches away from the session.

SESSION="k8s"

# Opt-in debug trace: run with KLOG_DEBUG=1 (e.g. `KLOG_DEBUG=1 tv k8s`) to append
# a line-by-line trace to $KLOG_LOG (default /tmp/klog-debug.log). Use it to see
# why a k8s session/window isn't appearing on a given machine.
KLOG_LOG="${KLOG_LOG:-/tmp/klog-debug.log}"
dbg() { [ -n "${KLOG_DEBUG:-}" ] && printf '%s [%s] %s\n' "$(date '+%H:%M:%S')" "$$" "$*" >>"$KLOG_LOG" 2>/dev/null; return 0; }

# --- streaming worker: this is what each log pane actually runs ---
if [ "${1:-}" = "--stream" ]; then
    export KCTX="$2" KNS="$3"; target="$4"

    # The formatted stream: JSON-highlighted, each line led by [ctx/ns/pod].
    emit() {
        printf '\033[2m── %s / %s · %s ──\033[0m\n' "$KCTX" "$KNS" "$target"
        kubectl logs -f "$target" -n "$KNS" --context "$KCTX" --all-containers --prefix --max-log-requests=30 2>&1 \
          | jq --unbuffered -R -r -C -c '
              (env.KCTX+"/"+env.KNS) as $w
              | (capture("^(\\[(?<p>[^\\]]+)\\]\\s+)?(?<m>.*)$")) as $c
              | ($c.m|try fromjson catch null) as $j
              | if ($j|type)=="object"
                then ({_at:$w} + (if $c.p then {_pod:$c.p} else {} end) + $j)
                else "[" + $w + (if $c.p then "/"+$c.p else "" end) + "] " + $c.m
                end'
    }

    # Default: view in `less -RS +F` — no wrap (←/→ scroll wide lines), '/' search,
    # full scrollback, follows live like tail. A background writer feeds a temp
    # file and IGNORES SIGINT, so Ctrl-C only pauses less's follow instead of
    # killing the tail (a naive `emit | less +F` shares the pgroup, so Ctrl-C would
    # SIGINT kubectl/jq too). Shift-F resumes, q quits. KLOG_LESS=0 → live pane.
    if [ "${KLOG_LESS:-1}" = 1 ] && command -v less >/dev/null 2>&1; then
        f=$(mktemp "${TMPDIR:-/tmp}/klog.XXXXXX") || { emit; exit 0; }
        ( trap '' INT; emit >>"$f" 2>&1 ) &
        writer=$!
        trap 'kill "$writer" 2>/dev/null; rm -f "$f"' EXIT HUP TERM
        less -RS +F "$f"
    else
        emit
        printf '\n\033[2m[log stream ended — press enter to close]\033[0m'; read -r _ </dev/tty 2>/dev/null || true
    fi
    exit 0
fi

# --- helpers (shared by single + group modes) ---

# window id of $1 (window name) inside the k8s session, or empty if none.
win_id() {
    tmux list-windows -t "$SESSION" -F '#{window_id} #{window_name}' 2>/dev/null \
      | awk -v w="$1" '$2==w{print $1; exit}'
}

# bring the current terminal into the k8s session, focused on window id $1 —
# switch-client when we're already in tmux, otherwise attach.
focus() {
    tmux select-window -t "$1" 2>/dev/null
    if [ -n "${TMUX:-}" ]; then
        dbg "focus: inside tmux -> switch-client -t $1"
        tmux switch-client -t "$1"; dbg "switch-client rc=$?"
    else
        dbg "focus: not in tmux -> attach-session -t $SESSION"
        tmux attach-session -t "$SESSION"; dbg "attach rc=$?"
    fi
}

# --- group mode: one pane per context in the group, combined (kclog-style) ---
if [ "${1:-}" = "--group" ]; then
    group="$2"; target="$3"
    [ -z "$target" ] && { echo "usage: klog --group <group> <pod|deployment/name>" >&2; exit 1; }
    TGT="${TV_K8S_TARGETS:-$HOME/.config/television/k8s-targets}"
    self=$(command -v "$0" 2>/dev/null || echo "$0")
    short=$(printf '%s' "$target" | tr '/' '-' | cut -c1-18)
    win="log:$group-$short"

    id=""
    tmux has-session -t "$SESSION" 2>/dev/null && id=$(win_id "$win")
    if [ -z "$id" ]; then
        first=1
        while read -r grp ctx ns _; do
            case "$grp" in ''|\#*) continue ;; esac
            [ "$grp" = "$group" ] || continue
            [ -z "$ns" ] && continue
            # Only open a pane where the target actually exists — skip namespaces
            # in the group that don't run this deployment/pod (and unreachable
            # contexts, via the short timeout). This is why "all in the group" was
            # opening panes that just errored.
            kubectl get "$target" -n "$ns" --context "$ctx" --request-timeout=5s >/dev/null 2>&1 || continue
            pane="$self --stream '$ctx' '$ns' '$target'"
            if [ -n "$first" ]; then
                if tmux has-session -t "$SESSION" 2>/dev/null; then
                    id=$(tmux new-window -t "$SESSION" -P -F '#{window_id}' -n "$win" "$pane")
                else
                    id=$(tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$win" "$pane")
                fi
                first=""
            else
                tmux split-window -t "$id" "$pane"
                tmux select-layout -t "$id" tiled >/dev/null 2>&1
            fi
        done < "$TGT"
        [ -z "$id" ] && { echo "no targets for group '$group' in $TGT" >&2; exit 1; }
        tmux set-window-option -t "$id" remain-on-exit on >/dev/null 2>&1
        tmux select-layout -t "$id" tiled >/dev/null 2>&1
    fi
    focus "$id"
    exit 0
fi

# --- single-target mode ---
ctx="$1"; ns="$2"; target="$3"
[ -z "$target" ] && { echo "usage: klog <context> <namespace> <pod|deployment/name>" >&2; exit 1; }

short=$(printf '%s' "$target" | tr '/' '-' | cut -c1-24)
win="log:$short"
self=$(command -v "$0" 2>/dev/null || echo "$0")
stream="$self --stream '$ctx' '$ns' '$target'"
dbg "single: ctx=$ctx ns=$ns target=$target TMUX=${TMUX:-<unset>} tmux=$(command -v tmux || echo MISSING)"

id=""
tmux has-session -t "$SESSION" 2>/dev/null && id=$(win_id "$win")
if [ -z "$id" ]; then
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        dbg "k8s session exists -> new-window"
        id=$(tmux new-window -t "$SESSION" -P -F '#{window_id}' -n "$win" "$stream")
    else
        dbg "k8s session missing -> new-session"
        id=$(tmux new-session -d -P -F '#{window_id}' -s "$SESSION" -n "$win" "$stream")
    fi
    dbg "created window id=[$id]"
    tmux set-window-option -t "$id" remain-on-exit on >/dev/null 2>&1
else
    dbg "reusing existing window id=[$id]"
fi
focus "$id"
