#!/usr/bin/env bash
# glab-pipelines - Browse and open GitLab pipelines from terminal
# Usage: glab-pipelines [gitlab-url] [--branch|--all] [--cloudbees] [--diff]

set -e

# Colors
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
MAGENTA=$'\033[0;35m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# Parse args
MODE="branch"
CUSTOM_GITLAB_URL=""
CLOUDBEES=false
DIFF_MODE=false
WATCH_PIPELINE=""
LIST_MODE=false
PIN_URL=""
UNPIN_URL=""
PINNED_MODE=false
WATCH_BG_URL=""
WATCH_RUN_URL=""
GOTO_URL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --all)
            MODE="all"
            shift
            ;;
        --branch)
            MODE="branch"
            shift
            ;;
        --list)
            LIST_MODE=true
            shift
            ;;
        --pin)
            PIN_URL="${2:-}"
            [[ -z "$PIN_URL" || "$PIN_URL" == -* ]] && { echo "--pin needs a pipeline url"; exit 1; }
            shift 2
            ;;
        --unpin)
            UNPIN_URL="${2:-}"
            [[ -z "$UNPIN_URL" || "$UNPIN_URL" == -* ]] && { echo "--unpin needs a pipeline url"; exit 1; }
            shift 2
            ;;
        --pinned|--tracker)
            PINNED_MODE=true
            shift
            ;;
        --watch-bg)
            WATCH_BG_URL="${2:-}"
            [[ -z "$WATCH_BG_URL" || "$WATCH_BG_URL" == -* ]] && { echo "--watch-bg needs a url"; exit 1; }
            shift 2
            ;;
        --watch-run)
            WATCH_RUN_URL="${2:-}"
            [[ -z "$WATCH_RUN_URL" || "$WATCH_RUN_URL" == -* ]] && { echo "--watch-run needs a url"; exit 1; }
            shift 2
            ;;
        --goto)
            GOTO_URL="${2:-}"
            [[ -z "$GOTO_URL" || "$GOTO_URL" == -* ]] && { echo "--goto needs a url"; exit 1; }
            shift 2
            ;;
        --cloudbees|-c)
            CLOUDBEES=true
            shift
            ;;
        --diff|-d)
            DIFF_MODE=true
            shift
            ;;
        --watch|-w)
            WATCH_PIPELINE="${2:-}"
            if [[ -z "$WATCH_PIPELINE" ]] || [[ "$WATCH_PIPELINE" == -* ]]; then
                WATCH_PIPELINE=""
            else
                shift
            fi
            shift
            ;;
        -h|--help)
            echo "Usage: glab-pipelines [gitlab-url] [options]"
            echo ""
            echo "Args:"
            echo "  --branch    Show pipelines for current branch only (default)"
            echo "  --all       Show all pipelines for the project"
            echo "  --cloudbees Open CloudBees links instead of GitLab"
            echo "  --diff      Show git diff in preview"
            echo "  --watch      Watch pipeline (ID or Ctrl-W in fzf)"
            echo "  -h, --help  Show this help"
            echo ""
            echo "Token: Uses GITLAB_TOKEN env var, or reads from macOS Keychain"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            CUSTOM_GITLAB_URL="${1:-$CUSTOM_GITLAB_URL}"
            shift
            ;;
    esac
done

# Get token from keychain or env var
get_token() {
    local host="${1:-gitlab.com}"
    local token="${GITLAB_TOKEN:-${GLAB_TOKEN:-}}"
    
    if [[ -z "$token" ]]; then
        token=$(security find-internet-password -s "$host" 2>/dev/null | grep "password" | cut -d'"' -f4 || true)
    fi
    
    if [[ -z "$token" ]]; then
        echo -e "${RED}Error: GITLAB_TOKEN not set and no keychain entry found${NC}"
        exit 1
    fi
    echo "$token"
}

get_current_branch() {
    git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main"
}

get_repo() {
    local remote
    remote=$(git remote get-url origin 2>/dev/null || git remote -v 2>/dev/null | head -1 | awk '{print $2}' || echo "")
    
    if [[ -z "$remote" ]]; then
        if [[ -n "$CUSTOM_GITLAB_URL" ]]; then
            remote="git@${CUSTOM_GITLAB_URL}:unknown/repo.git"
        else
            echo -e "${RED}Error: No git remote found${NC}"
            exit 1
        fi
    fi
    
    if [[ "$remote" =~ git@([^:]+):([^/]+)/(.+)\.git$ ]]; then
        host="${BASH_REMATCH[1]}"
        owner="${BASH_REMATCH[2]}"
        repo="${BASH_REMATCH[3]}"
    elif [[ "$remote" =~ https?://([^/]+)/([^/]+)/(.+)$ ]]; then
        host="${BASH_REMATCH[1]}"
        owner="${BASH_REMATCH[2]}"
        repo="${BASH_REMATCH[3]%.git}"
    else
        echo -e "${RED}Error: Could not parse git remote: $remote${NC}"
        exit 1
    fi
    
    if [[ -n "$CUSTOM_GITLAB_URL" ]]; then
        host="${CUSTOM_GITLAB_URL#https://}"
        host="${CUSTOM_GITLAB_URL#http://}"
        host="${host%%/*}"
    fi
    
    echo "$host $owner $repo"
}

get_status_icon() {
    case "$1" in
        success) echo "✓" ;;
        failed) echo "✗" ;;
        running) echo "◐" ;;
        pending) echo "○" ;;
        canceled) echo "⊘" ;;
        skipped) echo "⊝" ;;
        created) echo "◌" ;;
        *) echo "?" ;;
    esac
}

get_status_color() {
    case "$1" in
        success) echo "green" ;;
        failed) echo "red" ;;
        running) echo "blue" ;;
        pending) echo "yellow" ;;
        canceled) echo "yellow" ;;
        skipped) echo "white" ;;
        *) echo "white" ;;
    esac
}

fetch_pipelines() {
    local host="$1"
    local owner="$2"
    local repo="$3"
    local token="$4"
    local branch="$5"
    local limit="${6:-50}"
    
    local api_url="https://${host}/api/v4"
    local project_path="${owner}/${repo}"
    
    local url="${api_url}/projects/${project_path//\//%2F}/pipelines?per_page=${limit}"
    
    if [[ -n "$branch" ]]; then
        url+="&ref=${branch}"
    fi
    
    curl -s -H "PRIVATE-TOKEN: $token" "$url" 2>/dev/null
}

fetch_cloudbees_links() {
    local host="$1"
    local owner="$2"
    local repo="$3"
    local token="$4"
    local pipeline_id="$5"
    
    local api_url="https://${host}/api/v4"
    local project_path="${owner}/${repo}"
    
    local jobs
    jobs=$(curl -s -H "PRIVATE-TOKEN: $token" \
        "${api_url}/projects/${project_path//\//%2F}/pipelines/${pipeline_id}/jobs?per_page=50" 2>/dev/null)
    
    if [[ -z "$jobs" ]] || [[ "$jobs" == "[]" ]]; then
        return
    fi
    
    while IFS= read -r job; do
        local job_id
        job_id=$(echo "$job" | jq -r '.id // empty')
        
        [[ -z "$job_id" ]] && continue
        
        local trace
        trace=$(curl -s -H "PRIVATE-TOKEN: $token" \
            "${api_url}/projects/${project_path//\//%2F}/jobs/${job_id}/trace" 2>/dev/null | head -500)
        
        echo "$trace" | grep -oE 'https?://[^]"<>]+\.cloudbees\.com[^]"<>*' | sort -u
    done < <(echo "$jobs" | jq -c '.[]')
}

get_diff() {
    local ref="$1"
    local current_branch
    current_branch=$(get_current_branch)
    
    # Try to get diff between this ref and main/master
    local base_branch
    base_branch=$(git branch --list main master develop 2>/dev/null | head -1 | tr -d ' *' || echo "main")
    
    if [[ "$ref" == "$current_branch" ]]; then
        git diff "$base_branch...HEAD" --stat 2>/dev/null || git diff HEAD~10..HEAD --stat 2>/dev/null || echo "No diff available"
    else
        git diff "$base_branch...$ref" --stat 2>/dev/null || git diff "$ref~5..$ref" --stat 2>/dev/null || echo "No diff available"
    fi
}

# Watch a pipeline and notify when done
watch_pipeline() {
    local pipeline_id="$1"
    local host="$2"
    local owner="$3"
    local repo="$4"
    local token="$5"
    
    local api_url="https://${host}/api/v4"
    local project_path="${owner}/${repo}"
    
    echo -e "${YELLOW}Watching pipeline #${pipeline_id}... Press Ctrl-C to stop${NC}"
    
    while true; do
        local response
        response=$(curl -s -H "PRIVATE-TOKEN: $token" \
            "${api_url}/projects/${project_path//\//%2F}/pipelines/${pipeline_id}")
        
        local status web_url
        status=$(echo "$response" | jq -r '.status // "unknown"')
        web_url=$(echo "$response" | jq -r '.web_url // ""')
        
        if [[ "$status" == "success" ]]; then
            osascript -e 'display notification "Pipeline #'"$pipeline_id"' succeeded!" with title "GitLab Pipeline" sound name "Glass"' \
                -e "open location \"$web_url\""
            echo -e "${GREEN}✓ Pipeline #${pipeline_id} succeeded!${NC}"
            break
        elif [[ "$status" == "failed" ]]; then
            osascript -e 'display notification "Pipeline #'"$pipeline_id"' failed!" with title "GitLab Pipeline" sound name "Basso"' \
                -e "open location \"$web_url\""
            echo -e "${RED}✗ Pipeline #${pipeline_id} failed!${NC}"
            break
        elif [[ "$status" == "canceled" ]]; then
            osascript -e 'display notification "Pipeline #'"$pipeline_id"' was canceled!" with title "GitLab Pipeline"' \
                -e "open location \"$web_url\""
            echo -e "${YELLOW}⊘ Pipeline #${pipeline_id} canceled${NC}"
            break
        elif [[ "$status" == "running" ]]; then
            echo -e "${BLUE}◐ Still running...${NC}"
        else
            echo -e "${YELLOW}Status: $status${NC}"
        fi
        
        sleep 60
    done
}

# ---------------------------------------------------------------------------
# Pinned-pipeline tracker: a persistent watchlist across repos. A pipeline's
# web_url encodes host + project + id, so each pin is just its URL — we re-derive
# everything to re-fetch its current status.
# ---------------------------------------------------------------------------
PIN_STORE="${XDG_STATE_HOME:-$HOME/.local/state}/glab-pipelines/pinned"

# Token lookup that never exits (get_token aborts on miss; the tracker must not).
get_token_soft() {
    local host="${1:-gitlab.com}"
    local token="${GITLAB_TOKEN:-${GLAB_TOKEN:-}}"
    [[ -z "$token" ]] && token=$(security find-internet-password -s "$host" 2>/dev/null | grep "password" | cut -d'"' -f4 || true)
    echo "$token"
}

# Parse a pipeline web_url -> P_HOST P_PROJECT P_ID
parse_pipeline_url() {
    local url="$1" rest path
    rest="${url#*://}"
    P_HOST="${rest%%/*}"
    path="${rest#*/}"
    P_PROJECT="${path%%/-/pipelines/*}"
    P_ID="${path##*/-/pipelines/}"
    P_ID="${P_ID%%[/?#]*}"
}

pin_add() {
    local url="$1"
    mkdir -p "$(dirname "$PIN_STORE")"; touch "$PIN_STORE"
    if grep -qxF "$url" "$PIN_STORE" 2>/dev/null; then
        echo "already pinned"
    else
        echo "$url" >> "$PIN_STORE"; echo "pinned"
    fi
}

pin_remove() {
    local url="$1"
    [[ -f "$PIN_STORE" ]] || return 0
    grep -vxF "$url" "$PIN_STORE" > "${PIN_STORE}.tmp" 2>/dev/null || true
    mv "${PIN_STORE}.tmp" "$PIN_STORE"
}

# TSV for the pinned sub-source. Columns match --list (id status ref context url)
# so the gitlab-pipelines channel shares one display template; context=project.
list_pinned() {
    [[ -f "$PIN_STORE" ]] || return 0
    local url token resp status ref web
    while IFS= read -r url; do
        [[ -z "$url" ]] && continue
        parse_pipeline_url "$url"
        [[ -z "$P_ID" ]] && continue
        token=$(get_token_soft "$P_HOST")
        resp=$(curl -s -H "PRIVATE-TOKEN: $token" \
            "https://${P_HOST}/api/v4/projects/${P_PROJECT//\//%2F}/pipelines/${P_ID}" 2>/dev/null || true)
        status=$(echo "$resp" | jq -r '.status // "unknown"' 2>/dev/null || echo unknown)
        ref=$(echo "$resp"    | jq -r '.ref // "?"'        2>/dev/null || echo "?")
        web=$(echo "$resp"    | jq -r '.web_url // empty'  2>/dev/null || echo "")
        [[ -z "$web" ]] && web="$url"
        [[ -z "$status" ]] && status="unknown"
        printf '%s\t%s\t%s\t%s\t%s\n' "$P_ID" "$status" "$ref" "$P_PROJECT" "$web"
    done < "$PIN_STORE"
}

# --- background watch + jump-to-session (both take a pipeline web_url) --------

# Fire off a detached watcher and return immediately, so the tv popup can close.
watch_bg() {
    parse_pipeline_url "$1"
    nohup "$0" --watch-run "$1" >/dev/null 2>&1 &
    echo "▶ watching pipeline #${P_ID} in the background — you'll get a notification when it finishes."
}

# The detached loop: poll until a terminal status, notify, then exit.
watch_run() {
    parse_pipeline_url "$1"
    local token resp status title sound
    token=$(get_token_soft "$P_HOST")
    while true; do
        resp=$(curl -s -H "PRIVATE-TOKEN: $token" \
            "https://${P_HOST}/api/v4/projects/${P_PROJECT//\//%2F}/pipelines/${P_ID}" 2>/dev/null || true)
        status=$(echo "$resp" | jq -r '.status // "unknown"' 2>/dev/null || echo unknown)
        case "$status" in
            success)            title="✓ Pipeline #${P_ID} passed";   sound="Glass"; break ;;
            failed)             title="✗ Pipeline #${P_ID} failed";   sound="Basso"; break ;;
            canceled|skipped)   title="⊘ Pipeline #${P_ID} ${status}"; sound="Funk";  break ;;
            manual)             title="⏸ Pipeline #${P_ID} waiting (manual)"; sound="Funk"; break ;;
            unknown)            title="? Pipeline #${P_ID} not found"; sound="Funk";  break ;;
        esac
        sleep 30
    done
    osascript -e "display notification \"${P_PROJECT}\" with title \"${title}\" sound name \"${sound}\"" >/dev/null 2>&1
}

# Jump to (or create) the local tmux session for a pinned pipeline's project.
goto_session() {
    parse_pipeline_url "$1"
    local repo name dir
    repo="${P_PROJECT##*/}"                 # basename of the gitlab project path
    name=$(printf '%s' "$repo" | tr '.' '_')  # sessionizer session-name convention
    if ! tmux has-session -t="$name" 2>/dev/null; then
        # best-effort: find a local checkout among tmux-sessionizer's roots
        dir=$("$HOME/.local/bin/tmux-sessionizer" --list 2>/dev/null | grep -iE "/${repo}$" | head -1)
        if [[ -z "$dir" ]]; then
            osascript -e "display notification \"No local checkout for ${repo}\" with title \"gitlab\"" >/dev/null 2>&1
            return 0
        fi
        tmux new-session -ds "$name" -c "$dir"
    fi
    [[ -n "${TMUX:-}" ]] && tmux switch-client -t "$name" || tmux attach-session -t "$name"
}

main() {
    # If watch mode with no ID, flag to watch after selection
    local WATCH_AFTER_SELECT=false
    if [[ -n "$WATCH_PIPELINE" ]]; then
        read -r host owner repo <<< "$(get_repo)"
        local token
        token=$(get_token "$host")
        watch_pipeline "$WATCH_PIPELINE" "$host" "$owner" "$repo" "$token"
        exit 0
    fi
    
    # Check if --watch flag was passed without ID (for interactive selection)
    # We need to check the original args before they get shifted
    local original_args=("$@")
    local WATCH_AFTER_SELECT=false
    for arg in "${original_args[@]}"; do
        if [[ "$arg" == "--watch" || "$arg" == "-w" ]]; then
            WATCH_AFTER_SELECT=true
        fi
    done
    
    read -r host owner repo <<< "$(get_repo)"
    
    local token
    token=$(get_token "$host")
    
    local branch=""
    if [[ "$MODE" == "branch" ]]; then
        branch=$(get_current_branch)
    fi

    # --list: machine-readable TSV for the television `gitlab-pipelines` channel.
    # Exits before the banner/fzf below so the ci/cia interactive flow is untouched.
    if [[ "$LIST_MODE" == "true" ]]; then
        local pipelines
        pipelines=$(fetch_pipelines "$host" "$owner" "$repo" "$token" "$branch" 30)
        if [[ -z "$pipelines" || "$pipelines" == "[]" || ! "$pipelines" =~ ^\[ ]]; then
            exit 0
        fi
        echo "$pipelines" | jq -r '.[] | [.id, .status, .ref, (.created_at // "")[0:16], .web_url] | @tsv'
        exit 0
    fi
    
    echo -e "${BLUE}${BOLD}GitLab Pipeline Browser${NC}"
    echo -e "${CYAN}Repo:${NC} ${owner}/${repo}"
    echo -e "${CYAN}Host:${NC} ${host}"
    [[ -n "$branch" ]] && echo -e "${CYAN}Branch:${NC} ${branch}" || echo -e "${CYAN}Mode:${NC} all pipelines"
    [[ "$CLOUDBEES" == "true" ]] && echo -e "${MAGENTA}CloudBees mode${NC}"
    [[ "$DIFF_MODE" == "true" ]] && echo -e "${MAGENTA}Diff preview enabled${NC}"
    echo ""
    
    local pipelines
    pipelines=$(fetch_pipelines "$host" "$owner" "$repo" "$token" "$branch" 30)
    
    if [[ -n "$pipelines" ]] && [[ ! "$pipelines" =~ ^\[ ]]; then
        echo -e "${YELLOW}API Response: $pipelines${NC}"
    fi
    
    if [[ -z "$pipelines" ]] || [[ "$pipelines" == "[]" ]]; then
        echo -e "${YELLOW}No pipelines found${NC}"
        exit 0
    fi
    
    if [[ "$pipelines" =~ \{.*message.*\} ]]; then
        echo -e "${RED}API Error: $pipelines${NC}"
        exit 1
    fi
    
    local fzf_entries=""
    while IFS= read -r line; do
        local id status ref created_at web_url
        id=$(echo "$line" | jq -r '.id // empty')
        status=$(echo "$line" | jq -r '.status // empty')
        ref=$(echo "$line" | jq -r '.ref // empty')
        created_at=$(echo "$line" | jq -r '.created_at // empty')
        web_url=$(echo "$line" | jq -r '.web_url // empty')
        
        ref="${ref:0:40}"
        
        local date
        if [[ -n "$created_at" ]]; then
            date=$(date -j -f "%Y-%m-%dT%H:%M:%S%z" "$created_at" "+%m/%d %H:%M" 2>/dev/null || echo "${created_at:0:16}")
        else
            date="--/--"
        fi
        
        local icon color
        icon=$(get_status_icon "$status")
        color=$(get_status_color "$status")
        
        local extra=""
        if [[ "$CLOUDBEES" == "true" ]]; then
            local cb_links
            cb_links=$(fetch_cloudbees_links "$host" "$owner" "$repo" "$token" "$id")
            if [[ -n "$cb_links" ]]; then
                echo "$cb_links" > "/tmp/cb_${id}.txt"
                extra=" | $(echo "$cb_links" | head -1)"
            else
                extra=" | (no CB)"
            fi
        fi
        
        local id_color
        if [[ "$status" == "failed" ]]; then
            id_color="$RED"
        else
            id_color="$GREEN"
        fi
        
        # Simplified: just icon, #id, branch, date (no status text)
        local entry
        entry="${icon} ${id_color}#${id}${NC} | ${CYAN}${ref}${NC} | ${date}${extra} | ${web_url}"
        
        fzf_entries+="$entry"$'\n'
    done < <(echo "$pipelines" | jq -c '.[]')
    
    local fzf_opts=(
        --prompt="Select: "
        --preview-window=hidden
        --height=20
        --reverse
        --ansi
    )
    
    if [[ "$DIFF_MODE" == "true" ]]; then
        # Preview with diff stats
        fzf_opts+=(
            --preview="echo {} | grep -oP '#\K[0-9]+' | head -1 | xargs -I{} sh -c 'git log --oneline -5 2>/dev/null | head -20 || echo \"No diff\"'"
        )
    fi
    
    # Add Ctrl-W to watch selected pipeline
    fzf_opts+=(
        --bind="ctrl-w:execute(echo WATCH_ME:{} > /tmp/ci_watch)+abort"
    )
    
    local selected
    
    local selected
    selected=$(echo "$fzf_entries" | fzf "${fzf_opts[@]}")
    
    [[ -z "$selected" ]] && exit 0
    
    local url
    url=$(echo "$selected" | sed 's/.*| //')
    
    if [[ "$CLOUDBEES" == "true" ]]; then
        local pipeline_id
        pipeline_id=$(echo "$selected" | grep -oP '#\K[0-9]+' | head -1)
        
        if [[ -n "$pipeline_id" ]] && [[ -f "/tmp/cb_${pipeline_id}.txt" ]]; then
            local cb_links link_count
            cb_links=$(cat "/tmp/cb_${pipeline_id}.txt" | sort -u)
            link_count=$(echo "$cb_links" | grep -c . || echo 0)
            
            if [[ "$link_count" -gt 1 ]]; then
                echo -e "${CYAN}Multiple CloudBees links:${NC}"
                local chosen_link
                chosen_link=$(echo "$cb_links" | fzf --prompt="Select: " --height=15 --reverse)
                [[ -n "$chosen_link" ]] && url="$chosen_link"
            elif [[ "$link_count" -eq 1 ]]; then
                url=$(echo "$cb_links" | head -1)
            fi
            
            rm -f "/tmp/cb_${pipeline_id}.txt"
        fi
    fi
    
    # If watch flag was passed interactively, watch instead of open
    if [[ "$WATCH_AFTER_SELECT" == "true" ]]; then
        local watch_id
        watch_id=$(echo "$selected" | grep -oP '#\K[0-9]+' | head -1)
        echo -e "${YELLOW}Starting watch on pipeline #${watch_id}...${NC}"
        watch_pipeline "$watch_id" "$host" "$owner" "$repo" "$token"
        exit 0
    fi
    
    echo -e "${GREEN}→ Opening:${NC} $url"
    open "$url"
}

# Pinned-tracker modes are repo-independent — handle them before main() (which
# requires a git remote).
if [[ -n "$PIN_URL" ]];       then pin_add "$PIN_URL";        exit 0; fi
if [[ -n "$UNPIN_URL" ]];     then pin_remove "$UNPIN_URL";    exit 0; fi
if [[ "$PINNED_MODE" == "true" ]]; then list_pinned;          exit 0; fi
if [[ -n "$WATCH_BG_URL" ]];  then watch_bg "$WATCH_BG_URL";   exit 0; fi
if [[ -n "$WATCH_RUN_URL" ]]; then watch_run "$WATCH_RUN_URL"; exit 0; fi
if [[ -n "$GOTO_URL" ]];      then goto_session "$GOTO_URL";   exit 0; fi

main
