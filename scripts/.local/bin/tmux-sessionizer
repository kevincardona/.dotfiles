#!/usr/bin/env bash

# Directories to search for sessions. Keep this list portable across machines --
# put host-specific paths (external drives, work-only checkouts) in the local
# paths file instead. Missing entries are skipped, so it is safe to list a path
# that only exists on some machines.
declare -a SEARCH_PATHS=(
    "$HOME"
    "$HOME/projects"
    "$HOME/.config"
    "$HOME/.dotfiles"
    "$HOME/nix-dev"
    "$HOME/work"
    "$HOME/work/valert"
    "$HOME/work/telekit"
    "$HOME/work/racc"
    "$HOME/work/number-provisioning"
    "$HOME/personal"
    "$HOME/personal/scratchpad"
    "$HOME/personal/godot-games"
    "$HOME/personal/rust-learn"
    "$HOME/Documents/GitHub"
)

# Extra machine-specific paths, one per line ('#' comments and '~' both allowed)
LOCAL_PATHS_FILE="${TMUX_SESSIONIZER_PATHS:-$HOME/.config/tmux-sessionizer/paths}"
if [[ -f $LOCAL_PATHS_FILE ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z $line ]] && continue
        SEARCH_PATHS+=("${line/#\~/$HOME}")
    done < "$LOCAL_PATHS_FILE"
fi

# Drop anything that isn't present on this machine (unmounted drives, etc.)
declare -a EXISTING_PATHS=()
for path in "${SEARCH_PATHS[@]}"; do
    [[ -d $path ]] && EXISTING_PATHS+=("$path")
done

usage() {
    echo "Usage: $0 [directory]"
    exit 1
}

# Check if exactly one argument is provided, if not use fzf to select directory
if [[ $# -eq 1 ]]; then
    selected=$1
elif [[ ${#EXISTING_PATHS[@]} -eq 0 ]]; then
    echo "tmux-sessionizer: no search paths exist on this machine" >&2
    exit 1
else
    selected=$(find "${EXISTING_PATHS[@]}" -mindepth 1 -maxdepth 1 -type d | fzf)
fi

# Exit if no directory was selected
if [[ -z $selected ]]; then
    exit 0
fi

# Create a safe session name by replacing periods with underscores
selected_name=$(basename "$selected" | tr . _)

# Check if tmux is running
tmux_running=$(pgrep tmux)

# If not inside a tmux session and tmux is not running, start a new session
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

# Create the session rooted at the selected directory
if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

# Attach or switch to the selected session
if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi

