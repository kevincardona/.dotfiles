# Kubernetes targets for the television `k8s` drill-down (group -> namespace -> pods).
#
# Format:  group  context  namespace  perm
#   group      logical bundle (e.g. same service across clusters); the top-level picker
#   context    kube-context (from your kubeconfig)
#   namespace  namespace to browse
#   perm       ro = read-only (safe default) | rw = allow exec / rollout restart
#
# '#' comments and blank lines are ignored. Missing/unreachable contexts are skipped.
# Never uses --all-namespaces. Leave prod as 'ro' unless you really mean it.
#
# Copy to ~/.config/television/k8s-targets and edit per machine.

local  rancher-desktop  default  rw

# test  sf-test  number-provisioning-beta  rw
# test  au-test  number-provisioning-beta  rw
# prod  sf-prod  number-provisioning        ro
# prod  au-prod  number-provisioning        ro
