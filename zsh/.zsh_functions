sw() {
    local website=$1
    local query="${@:2}"
    local encoded_query=$(jq -nr --arg query "$query" '$query | @uri')
    declare -A url_templates=(
        ["yt"]="https://www.youtube.com/results?search_query=${encoded_query}"
        ["gh"]="https://github.com/search?q=owner%3Akevincardona%20${encoded_query}"
        ["conf"]="https://vailsys.atlassian.net/wiki/search?text=${encoded_query}"
        ["jira"]="https://vailsys.atlassian.net/issues/?smartQueryDisabled=true&wildcardAdded=true&jql=text%20%7E%20%22${encoded_query}%22"
        ["ticket"]="https://vailsys.atlassian.net/browse/${encoded_query}"
        ["j"]="https://www.jira.com/browse/${encoded_query}"
        ["d"]="https://duckduckgo.com/?q=${encoded_query}"
        ["g"]="https://www.google.com/search?q=${encoded_query}"
        ["n"]="https://www.netflix.com/search?q=${encoded_query}"
        ["h"]="https://www.hulu.com/search?q=${encoded_query}"
        ["c"]="https://www.crunchyroll.com/search?q=${encoded_query}"
    )
    local url_template=${url_templates[$website]}
    if [[ -z "$url_template" ]]; then
        echo "Website identifier '$website' is not recognized."
        return 1
    fi
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        xdg-open "$url_template"
    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        cmd.exe /c start "" "$url_template"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        open "$url_template"
    else
        echo "Unsupported operating system: $OSTYPE"
        return 1
    fi
}

check_deployments_by_name() {
  local search_name=$1
  local namespace="number-provisioning-beta"
  local contexts=("sf-test" "au-test")

  for context in "${contexts[@]}"; do
    echo "🔍 Checking in context: $context"
    kubectl --context="$context" -n "$namespace" get deployments \
      --no-headers \
      | grep "$search_name" \
      || echo "No deployments found matching '$search_name' in $context"
    echo "--------------------------------------------"
  done
}

kclog() {
  local container_name=""
  local namespace="number-provisioning-beta"  # default
  local contexts=("sf-test" "au-test")
  local pod_name_fragment=""

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--container)
        container_name="$2"
        shift 2
        ;;
      -n|--namespace)
        namespace="$2"
        shift 2
        ;;
      *)
        pod_name_fragment="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$pod_name_fragment" ]]; then
    echo "Usage: kclog [-n namespace] [-c container_name] <pod_name_fragment>"
    return 1
  fi

  for context in "${contexts[@]}"; do
    echo -e "\n🔍 Context: $context (namespace: $namespace)"

    pods=$(kubectl --context="$context" -n "$namespace" get pods --no-headers | grep "$pod_name_fragment" | awk '{print $1}')

    if [ -z "$pods" ]; then
      echo "No matching pods found in $context"
      continue
    fi

    echo "$pods" | while read -r pod; do
      echo -e "\n📦 Logs for pod: $pod"

      if [[ -n "$container_name" ]]; then
        echo -e "\n🧩 Container: $container_name"
        kubectl --context="$context" -n "$namespace" logs "$pod" -c "$container_name" --tail=100
      else
        containers=$(kubectl --context="$context" -n "$namespace" get pod "$pod" -o jsonpath='{.spec.containers[*].name}')
        IFS=' ' read -r -a container_array <<< "$containers"

        for container in "${container_array[@]}"; do
          echo -e "\n🧩 Container: $container"
          kubectl --context="$context" -n "$namespace" logs "$pod" -c "$container" --tail=100
        done
      fi

      echo "----------------------------------------"
    done
  done
}

ccd() {
    local selected=$(find ~ ~/projects ~/.config ~/.dotfiles ~/work ~/work/number-provisioning ~/work/valert ~/work/telekit ~/work/racc ~/personal ~/personal/scratchpad -mindepth 1 -maxdepth 1 -type d | fzf)
    if [[ -z $selected ]]; then
        echo "No directory selected."
        return 1
    fi
    cd "$selected" || return
    if [[ -n $TMUX ]]; then
        tmux send-keys "cd $selected" C-m
    fi
}

cdr() {
  cd "$(git rev-parse --show-toplevel)"
}

cdrr() {
  cdr && cd .. && cdr
}

cds() {
  if git submodule status; then
    local submodule_path
    submodule_path=$(git submodule status | awk '{print $2}' | fzf --height 40% --reverse --border)
    if [ -n "$submodule_path" ]; then
      cd "$submodule_path" || echo "Failed to change directory to submodule: $submodule_path"
    else
      echo "No submodule selected."
    fi
  else
    echo "No submodules found or not inside a Git repository."
  fi
}

lazy_load() {
    local -a names
    if [[ -n "$ZSH_VERSION" ]]; then
        names=("${(@s: :)${1}}")
    else
        names=($1)
    fi
    unalias "${names[@]}"
    . $2
    shift 2
    $*
}

group_lazy_load() {
    local script
    script=$1
    shift 1
    for cmd in "$@"; do
        alias $cmd="lazy_load \"$*\" $script $cmd"
    done
}

# Connect or disconnect AirPods
ap() {
    if ! type "blueutil" > /dev/null; then
        brew install blueutil
    fi
    if blueutil --paired | grep -q "10-b5-88-9e-34-81, connected"; then
        echo "AirPods are connected. Disconnecting..."
        blueutil --disconnect 10-b5-88-9e-34-81
    else
        echo "Connecting AirPods..."
        blueutil --connect 10-b5-88-9e-34-81
        if [ $? -ne 0 ]; then
            echo "Failed to connect AirPods."
            return 1
        fi
        echo "AirPods connected."
    fi
}

spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

gw() {
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$root" ]]; then
        echo "Not in a git repository"
        return 1
    fi

    worktree=$(git worktree list | fzf --height 40% --reverse | awk '{print $1}')
    if [[ -n "$worktree" ]]; then
        cd "$worktree"
    fi
}

fzf-insert-last-command-output() {
    local last_command=$(fc -ln -1 | head -n 1)
    echo -e "\n\e[33mAre you sure you want to rerun '$last_command'? (y/n): \e[0m"
    read -k 1 reply
    echo  # Move to a new line after the input
    if [[ "$reply" =~ ^[Yy]$ ]]
    then
        (eval "$last_command" > /tmp/command_output.txt 2>&1) & 
        local cmd_pid=$!
        spinner $cmd_pid
        wait $cmd_pid
        local command_output=$(cat /tmp/command_output.txt)
        if [[ -z "$command_output" ]]; then
            echo "The command did not produce any output."
            return
        fi
        local selected_output=$(echo "$command_output" | tr ' ' '\n' | grep -v '^\s*$' | fzf --height 40% --reverse)
        if [[ -n $selected_output ]]; then
            LBUFFER+="$selected_output "
        fi
        zle reset-prompt
        zle -R
    else
        echo "Command execution canceled."
    fi
}
zle -N fzf-insert-last-command-output
bindkey '^O' fzf-insert-last-command-output

capitalize_files() {
    find . -type f | while read -r file; do
        dir=$(dirname "$file")
        base=$(basename "$file")

        # Skip files starting with "index" (case insensitive)
        if [[ "$base" =~ ^[Ii][Nn][Dd][Ee][Xx] ]]; then
            continue
        fi

        # Skip files ending in .ts (but allow .tsx, .jsx)
        if [[ "$base" == *.ts || "$base" == *.js ]]; then
            continue
        fi

        # Capitalize only the first letter
        new_name=$(echo "$base" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')

        # Rename only if the name has changed
        if [[ "$base" != "$new_name" ]]; then
            mv "$file" "$dir/$new_name"
            echo "Renamed: $file -> $dir/$new_name"
        fi
    done
}

function gems() {
  local ruby_path
  ruby_path=$(which ruby)

  if [[ ! -x "$ruby_path" ]]; then
    echo "Ruby not found. Are you using asdf with Ruby installed?" >&2
    return 1
  fi

  local gem_dir
  gem_dir=$(ruby -e 'puts Gem.default_dir')

  if [[ -d "$gem_dir" ]]; then
    cd "$gem_dir" || return 1
  else
    echo "Gem directory not found: $gem_dir" >&2
    return 1
  fi
}

# Ghost-add a file to Git: track it initially, then ignore changes
ghost_add() {
  local file="$1"

  if [ -z "$file" ]; then
    echo "Usage: ghost_add <file>"
    return 1
  fi

  # Stage the file with --intent-to-add if it's new
  git add --intent-to-add "$file" -f

  # Tell Git to assume it's unchanged from now on
  git update-index --assume-unchanged "$file"

  echo "Ghost-added $file: tracked but future changes will be ignored."
}

# Toggle between light and dark themes for tmux, kitty, and zsh
toggle_theme() {
  local theme_file="$HOME/.theme_mode"
  local current_theme="dark"
  
  # Read current theme if file exists
  if [[ -f "$theme_file" ]]; then
    current_theme=$(cat "$theme_file")
  fi
  
  # Toggle theme
  if [[ "$current_theme" == "dark" ]]; then
    new_theme="light"
  else
    new_theme="dark"
  fi
  
  # Save new theme
  echo "$new_theme" > "$theme_file"
  
  # Update kitty theme
  if [[ -n "$KITTY_WINDOW_ID" ]]; then
    kitty @ set-colors --all --configured ~/.dotfiles/kitty/.config/kitty/themes/${new_theme}.conf
  fi
  
  # Update tmux theme
  if [[ -n "$TMUX" ]]; then
    tmux source-file ~/.config/tmux/tmux.conf
  fi
  
  echo "Switched to $new_theme theme"
}

# Toggle lid sleep to ignore a broken sensor
sleepy() {
  if [[ $(pmset -g | grep disablesleep) == *0* ]]; then
    sudo pmset -a disablesleep 1
    echo "Lid Sensor Ignored: Your Mac will stay awake when closed."
  else
    sudo pmset -a disablesleep 0
    echo "Lid Sensor Active: Your Mac will sleep normally."
  fi
}


